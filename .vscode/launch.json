{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug drone_target_cli",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/drone_target_cli",
      "args": ["gpiochip4", "/dev/ttyHS1", "24", "100", "dz12-vX7mK4qT9r2w", "<task_id>"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "CMake: configure and build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for STL types in GDB.",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
